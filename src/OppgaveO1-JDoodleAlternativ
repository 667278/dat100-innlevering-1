import java.util.Scanner;

public class OppgaveO1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Skriv inn inntekt her: ");
        String line = sc.nextLine().trim();

        try {
            int inntekt = Integer.parseInt(line);

            if (inntekt < 0) {
                System.out.println("Du har skrevet en ugyldig sum!");
            } else if (inntekt <= 217_400) {
                System.out.println("Med denne inntekten betaler du ingen trinnskatt");
            } else {
                double skatt = 0.0;

            if (inntekt > 217_400) {
                skatt += (Math.min(inntekt, 306_050) - 217_400) * 0.017;
            }  
            if (inntekt > 306_050) {
                skatt += (Math.min(inntekt, 697_150) - 306_050) * 0.04;
            }
            if (inntekt > 697_150) {
                skatt += (Math.min(inntekt, 942_400) - 697_150) * 0.137;
            }
            if (inntekt > 942_400) {
                skatt += (Math.min(inntekt, 1_410_750) - 942_400) * 0.167;
            }
            if (inntekt > 1_410_750) {
                skatt += (inntekt - 1_410_750) * 0.177;
            }
            
            System.out.println("Med denne inntekten betaler du trinnskatt på " +
                                String.format("%.2f", skatt) + " kr");
            }

        } catch (NumberFormatException e) {
            System.out.println("Ugyldig tal — ver venleg og skriv eit heiltal utan bokstavar eller symbol.");
        } finally {
            sc.close();
        }
    }
}
